# Chave da API Google Gemini (obtenha em https://aistudio.google.com/apikey)
GEMINI_API_KEY=

# Modelo opcional (padrão: gemini-2.5-flash)
# GEMINI_MODEL=gemini-2.5-flash

# Para desenvolvimento local: servidor na porta 3001 (Vite faz proxy de /api)
# PORT=3001

# Diretório de dados (padrão: /data no Docker, use ./data localmente)
# DATA_DIR=./data

# Segredo JWT para tokens de autenticação (obrigatório em produção)
# JWT_SECRET=gerar-string-aleatoria-segura

# Admin inicial (criado automaticamente se não existir)
# ADMIN_EMAIL=seu-email-admin@exemplo.com
# ADMIN_PASSWORD=sua-senha-segura

# Desabilitar autenticação (útil para desenvolvimento local)
AUTH_ENABLED=true
